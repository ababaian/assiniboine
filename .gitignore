# Whitelist: ignore everything, then re-admit only code and documentation.
# This repo holds METHODS. Data lives in S3 (see README).
*
!*/
# code
!*.sh
!*.py
# documentation
!*.md
# small text results that document what each stage produced
!SUMMARY_*.txt
!LENGTH_HIST.txt
!.gitignore
# never, under any circumstances
*.fa
*.fasta
*.fa.*
*.csv
*.tsv
*.zst
*.gz
*.pkl
*.cm
*.k2d
*.hist
*.runs
*.done
*.log
*.raw
# upstream collaborator code + trained model: provenance is theirs, not ours
Lebowski/
# stage working directories and bulk outputs
01_kraken_filter/parts/
01_kraken_filter/unclassified/
01_kraken_filter/logs/
01_kraken_filter/claims/
01_kraken_filter/reports/
01_kraken_filter/counts/
02_circular_overlap/circular/
02_circular_overlap/hairpin/
02_circular_overlap/unmatched/
03_length_filter/lt200/
03_length_filter/in_range/
03_length_filter/gt6000/
03_length_filter/lenhist/
04_rod_screen/chunks/
04_rod_screen/results/
04_rod_screen/logs/
04_rod_screen/claims/
04_rod_screen/rfam/
# the October run's outputs, kept on disk but not in git
archive/original_pipeline/_run_outputs/
